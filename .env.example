# Supabase-Projekt (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: ruhigere CARTO-Grundkarte statt OpenStreetMap (kostenloser Schlüssel: carto.com/basemaps/apikey)
# NEXT_CARTO_BASEMAP_KEY=

# Nur lokal: Oberfläche mit erfundenen Beispieldaten ansehen, ohne Login und Datenbank.
# Niemals auf Vercel setzen.
# DEMO_MODE=1
